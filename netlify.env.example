# Netlify Environment Variables Template
# 
# INSTRUCTIONS:
# 1. Copy this file to netlify.env (or rename it)
# 2. Fill in your actual secrets below
# 3. Import to Netlify: Site settings → Environment variables → Import from file
# 4. OR manually add each variable in Netlify Dashboard
#
# IMPORTANT: Never commit this file with real secrets to git!

# =============================================================================
# STRIPE CONFIGURATION (Required for Payments)
# =============================================================================
# Get from: Stripe Dashboard → Developers → API keys
# Test Mode: Use keys starting with pk_test_ and sk_test_
# Live Mode: Use keys starting with pk_live_ and sk_live_

# Stripe Secret Key (Server-side only - NEVER expose in frontend)
# LIVE MODE: Use keys starting with sk_live_
# TEST MODE: Use keys starting with sk_test_
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Stripe Publishable Key (Safe for frontend)
# LIVE MODE: Use keys starting with pk_live_
# TEST MODE: Use keys starting with pk_test_
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Stripe Webhook Secret (After setting up webhook)
# Get from: Stripe Dashboard → Developers → Webhooks → [Your webhook] → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# SUPABASE CONFIGURATION (Required for Database & Auth)
# =============================================================================
# Get from: Supabase Dashboard → Project Settings → API

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Safe for frontend)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Server-side only - for webhooks)
# Get from: Supabase Dashboard → Project Settings → API → service_role key
# IMPORTANT: This key has admin access - NEVER expose in frontend!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase URL (for server-side functions - same as VITE_SUPABASE_URL but without VITE_)
# Some server-side functions may need this without the VITE_ prefix
SUPABASE_URL=https://your-project-id.supabase.co

# =============================================================================
# GOOGLE DRIVE API (Optional - for Google Drive file uploads)
# =============================================================================
# Get from: Google Cloud Console → APIs & Services → Credentials
# See: GOOGLE-DRIVE-SETUP.md for detailed setup instructions

# Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret (Optional - for server-side)
# Note: Google Picker API works with just Client ID in most cases
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google API Key
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Google Project ID (Optional)
VITE_GOOGLE_PROJECT_ID=your_google_project_id_here

# =============================================================================
# NETLIFY AUTO-SET VARIABLES (Don't set these manually)
# =============================================================================
# These are automatically set by Netlify:
# - URL (your site URL)
# - DEPLOY_PRIME_URL (deployment URL)
# - CONTEXT (production, deploy-preview, branch-deploy)
# - BRANCH (git branch name)

# =============================================================================
# NOTES:
# =============================================================================
# 1. Variables starting with VITE_ are exposed to the frontend
#    - Only put safe-to-expose keys here (publishable keys, public URLs)
# 
# 2. Variables WITHOUT VITE_ prefix are server-side only
#    - Use these for secret keys (STRIPE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY)
#    - These are ONLY available in Netlify Functions
# 
# 3. After adding variables, you MUST redeploy for them to take effect
#    - Go to: Deploys → Trigger deploy → Deploy site
# 
# 4. Test locally with .env.local file (see .env.local.example)
#    - Netlify CLI will use .env.local when running `netlify dev`
# 
# 5. For production, use live keys (pk_live_, sk_live_)
#    - Test thoroughly with test keys first!
#    - Switch to live keys only when ready for production

