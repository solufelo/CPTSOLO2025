# Copy to .env.production before running scripts/prepare-cpanel-upload.ps1
# These VITE_* values are baked into the frontend at build time.

VITE_API_URL=
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your_google_api_key

# cPanel Python app env vars (set in Setup Python App — NOT in this file):
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, URL=https://www.captainsolo.ca
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
